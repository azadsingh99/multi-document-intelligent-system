# Copy this file to `.env` and fill in local values.
# Never commit `.env` or real API keys.

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL — matches docker-compose.yml defaults (local/dev only)
POSTGRES_USER=mdis
POSTGRES_PASSWORD=change_me
POSTGRES_DB=mdis
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mdis:change_me@localhost:5432/mdis

# Uploads
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_UPLOAD=10
UPLOAD_DIR=./uploads

# AI provider: "mock" (default, deterministic) or "grok"
AI_PROVIDER=mock

# xAI Grok — used only when AI_PROVIDER=grok
# Put the real key in `.env` only. Leave this blank in the example.
GROK_API_KEY=
GROK_MODEL=grok-3-latest
GROK_BASE_URL=https://api.x.ai/v1

# Frontend (optional; Vite also proxies /api in development)
VITE_API_URL=http://localhost:3001
